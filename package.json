{
  "name": "@nowly/sdk",
  "description": "TypeScript SDK for creating Nowly website presences and Discord Rich Presence activities.",
  "homepage": "https://docs.nowly.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/nowly-presence/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/nowly-presence/sdk/issues"
  },
  "version": "1.7.1",
  "license": "MIT",
  "contributors": [
    {
      "name": "Gaëtan H",
      "url": "https://github.com/Steellgold"
    },
    {
      "name": "Anthony (KiMi)",
      "url": "https://github.com/q-kimi"
    }
  ],
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "simple-git-hooks": {
    "commit-msg": "node scripts/validate-commit-message.ts \"$1\""
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.9",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}

{
  "name": "@nowly/sdk",
  "description": "TypeScript SDK for creating Nowly website presences and Discord Rich Presence activities.",
  "homepage": "https://docs.nowly.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/nowly-presence/sdk.git"
  },
  "bugs": { "url": "https://github.com/nowly-presence/sdk/issues" },
  "version": "1.7.0",
  "license": "MIT",
  "contributors": [
    { "name": "Gaëtan H", "url": "https://github.com/Steellgold" },
    { "name": "Anthony (KiMi)", "url": "https://github.com/q-kimi" }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "6.0.3"
  }
}
